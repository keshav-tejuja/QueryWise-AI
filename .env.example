# Copy this file to .env and change the password.
# Use letters and digits only in POSTGRES_PASSWORD: it is embedded in a URL,
# and characters like @ : / # would break it unless URL-encoded.

APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=querywise
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=querywise_app
# Port on YOUR machine that maps to the Postgres container (only needed for tools like psql/DBeaver).
# Change this if 5433 is also taken.
POSTGRES_HOST_PORT=5433
# JWT signing key. Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=bHTAi_RYYmahcXAxizytUnV7aKf50f245pJG8QnyopLFgkWl3Tim9hZ88FG6JQpq
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Fernet key(s) used to encrypt saved database passwords. Comma-separated, NEWEST FIRST.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing every key makes saved passwords unrecoverable (users must re-enter them).
FERNET_KEYS=XPBdNlm3dF65zdqcm29vjE_3tzK6QfztF8FXZ4I_srM=

# Hostnames allowed to resolve to private addresses (comma-separated). "sampledb" is the demo database.
DB_HOST_ALLOWLIST=sampledb
# DANGER: disables the private-network protection entirely. Local experiments only.
DB_ALLOW_PRIVATE_HOSTS=false
CONNECTION_TEST_RATE_PER_MINUTE=10

# Host port for the demo "analytics" database (only needed for psql/DBeaver on Windows).
SAMPLE_DB_HOST_PORT=5434