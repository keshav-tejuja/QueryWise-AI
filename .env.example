# Copy this file to .env and change the password.
# Use letters and digits only in POSTGRES_PASSWORD: it is embedded in a URL,
# and characters like @ : / # would break it unless URL-encoded.

APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=querywise
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=querywise_app
# Port on YOUR machine that maps to the Postgres container (only needed for tools like psql/DBeaver).
# Change this if 5433 is also taken.
POSTGRES_HOST_PORT=5433
# JWT signing key. Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=bHTAi_RYYmahcXAxizytUnV7aKf50f245pJG8QnyopLFgkWl3Tim9hZ88FG6JQpq
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7